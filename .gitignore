# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# runtime data
/data/

# generated audio
/public/audio/uploads/
/public/audio/generated/
/public/audio/arena/

# python
__pycache__/
*.pyc
/.venv/

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev TLS cert (self-signed) and machine-specific SAN overrides
/certs/*.pem
/certs/*.local.cnf

# per-machine environment overrides (see scripts/local-env.example.sh)
/scripts/local-env.sh

# speaker corpus and fine-tuned checkpoints (personal data)
/datasets/
/models/

# exported voice bundles (model copies + personal reference clips)
/exports/
